# Duolingo Agent -- API Keys
# At least one key is required. Both are recommended for maximum reliability.

# Groq API Key (primary solver -- fast and free)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (fallback solver + screenshot vision)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
